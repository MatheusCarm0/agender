generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  professional
  receptionist
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum CommissionType {
  none
  percent
  fixed
}

enum NotificationChannel {
  email
  whatsapp
}

enum NotificationType {
  booking_reminder
  booking_confirmation
  booking_cancelled
  membership_expiring
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum CouponDiscountType {
  percent
  fixed
}

enum CouponScope {
  all
  service
}

enum BillingCycle {
  monthly
  quarterly
  yearly
}

enum UsageLimitType {
  unlimited
  limited
}

enum MembershipStatus {
  pending
  active
  suspended
  cancelled
  expired
}

enum PaymentStatusEnum {
  unpaid
  paid
}

model Business {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  timezone  String   @default("America/Sao_Paulo")
  plan      String   @default("free")
  subdomain String?  @unique
  logoUrl   String?  @map("logo_url")
  coverUrl  String?  @map("cover_url")
  onboardingStep        Int       @default(1) @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  onboardingSkipped     Json      @default("[]") @map("onboarding_skipped")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  professionals      Professional[]
  services           Service[]
  workingHours       WorkingHours[]
  scheduleBlocks     ScheduleBlock[]
  clients            Client[]
  appointments       Appointment[]
  pageCustomization  PageCustomization?
  recurringBlocks    RecurringBlock[]
  notificationLogs   NotificationLog[]
  coupons            Coupon[]
  membershipPlans    MembershipPlan[]
  clientMemberships  ClientMembership[]
  staffInvites       StaffInvite[]

  @@map("businesses")
}

model User {
  id             String        @id @default(cuid())
  businessId     String        @map("business_id")
  business       Business      @relation(fields: [businessId], references: [id])
  name           String
  email          String
  passwordHash   String        @map("password_hash")
  role           Role          @default(owner)
  professionalId String?       @unique @map("professional_id")
  professional   Professional? @relation(fields: [professionalId], references: [id])
  active         Boolean       @default(true)
  tokenVersion   Int           @default(0) @map("token_version")
  createdAt      DateTime      @default(now()) @map("created_at")

  staffInvites     StaffInvite[]
  passwordResets   PasswordResetToken[]

  @@unique([businessId, email])
  @@index([businessId])
  @@map("users")
}

model Professional {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  user       User?
  name       String
  bio        String?  @db.Text
  avatarUrl  String?  @map("avatar_url")
  active          Boolean        @default(true)
  commissionType  CommissionType @default(none) @map("commission_type")
  commissionValue Decimal        @default(0) @db.Decimal(10, 2) @map("commission_value")
  createdAt       DateTime       @default(now()) @map("created_at")

  services        ProfessionalService[]
  workingHours    WorkingHours[]
  blocks          ScheduleBlock[]
  recurringBlocks RecurringBlock[]
  appointments    Appointment[]

  @@index([businessId])
  @@map("professionals")
}

model Service {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  durationMin  Int      @map("duration_min")
  price        Decimal  @db.Decimal(10, 2)
  bufferBefore Int      @default(0) @map("buffer_before")
  bufferAfter  Int      @default(0) @map("buffer_after")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId])
  @@map("services")
}

model ProfessionalService {
  professionalId   String   @map("professional_id")
  professional     Professional @relation(fields: [professionalId], references: [id])
  serviceId        String   @map("service_id")
  service          Service  @relation(fields: [serviceId], references: [id])
  priceOverride    Decimal? @map("price_override") @db.Decimal(10, 2)
  durationOverride Int?     @map("duration_override")

  @@id([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

model WorkingHours {
  id             String       @id @default(cuid())
  businessId     String       @map("business_id")
  business       Business     @relation(fields: [businessId], references: [id])
  professionalId String       @map("professional_id")
  professional   Professional @relation(fields: [professionalId], references: [id])
  weekday        Int
  startTime      String       @map("start_time")
  endTime        String       @map("end_time")

  @@index([businessId])
  @@index([professionalId, weekday])
  @@map("working_hours")
}

model ScheduleBlock {
  id             String        @id @default(cuid())
  businessId     String        @map("business_id")
  business       Business      @relation(fields: [businessId], references: [id])
  professionalId String?       @map("professional_id")
  professional   Professional? @relation(fields: [professionalId], references: [id])
  startAt        DateTime      @map("start_at")
  endAt          DateTime      @map("end_at")
  reason         String?

  @@index([businessId])
  @@index([professionalId, startAt])
  @@map("schedule_blocks")
}

model Client {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  phone      String
  email      String?
  notes           String?   @db.Text
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  appointments      Appointment[]
  otps              ClientOtp[]
  notificationLogs  NotificationLog[]
  couponRedemptions CouponRedemption[]
  memberships       ClientMembership[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@map("clients")
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String            @map("business_id")
  business       Business          @relation(fields: [businessId], references: [id])
  professionalId String            @map("professional_id")
  professional   Professional      @relation(fields: [professionalId], references: [id])
  serviceId      String            @map("service_id")
  service        Service           @relation(fields: [serviceId], references: [id])
  clientId       String            @map("client_id")
  client         Client            @relation(fields: [clientId], references: [id])
  startAt        DateTime          @map("start_at")
  endAt          DateTime          @map("end_at")
  status         AppointmentStatus @default(scheduled)
  price          Decimal           @db.Decimal(10, 2)
  paymentStatus  String            @default("unpaid") @map("payment_status")
  paymentMethod  String?           @map("payment_method")
  paidAt         DateTime?         @map("paid_at")
  couponId        String?  @map("coupon_id")
  membershipId    String?  @map("membership_id")
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2) @map("discount_amount")
  notes           String?  @db.Text
  idempotencyKey  String?  @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")

  couponRedemption CouponRedemption?

  @@index([businessId])
  @@index([professionalId, startAt])
  @@unique([businessId, idempotencyKey])
  @@map("appointments")
}

model PageCustomization {
  businessId String   @id @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  theme      Json
  links      Json     @default("[]")
  socials    Json     @default("{}")
  headline   String?
  about      String?  @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("page_customizations")
}

model RecurringBlock {
  id             String        @id @default(cuid())
  businessId     String        @map("business_id")
  business       Business      @relation(fields: [businessId], references: [id])
  professionalId String?       @map("professional_id")
  professional   Professional? @relation(fields: [professionalId], references: [id])
  weekday        Int
  startTime      String        @map("start_time")
  endTime        String        @map("end_time")
  reason         String?

  @@index([businessId])
  @@index([professionalId, weekday])
  @@map("recurring_blocks")
}

model ClientOtp {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  clientId   String    @map("client_id")
  client     Client    @relation(fields: [clientId], references: [id])
  code       String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@index([businessId, createdAt])
  @@map("client_otps")
}

model NotificationLog {
  id         String              @id @default(cuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  clientId   String?             @map("client_id")
  client     Client?             @relation(fields: [clientId], references: [id])
  channel    NotificationChannel
  type       NotificationType
  status     NotificationStatus  @default(pending)
  payload    Json
  sentAt     DateTime?           @map("sent_at")
  error      String?
  referenceId String?            @map("reference_id")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([referenceId, type])
  @@index([businessId])
  @@index([status, createdAt])
  @@map("notification_logs")
}

model Coupon {
  id             String             @id @default(cuid())
  businessId     String             @map("business_id")
  business       Business           @relation(fields: [businessId], references: [id])
  code           String
  discountType   CouponDiscountType @map("discount_type")
  discountValue  Decimal            @db.Decimal(10, 2) @map("discount_value")
  scope          CouponScope        @default(all)
  serviceId      String?            @map("service_id")
  maxUses        Int?               @map("max_uses")
  usedCount      Int                @default(0) @map("used_count")
  perClientLimit Int?               @map("per_client_limit")
  validFrom      DateTime           @map("valid_from")
  validUntil     DateTime?          @map("valid_until")
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")

  redemptions CouponRedemption[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String   @map("coupon_id")
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  appointmentId   String   @unique @map("appointment_id")
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  clientId        String   @map("client_id")
  client          Client   @relation(fields: [clientId], references: [id])
  discountApplied Decimal  @db.Decimal(10, 2) @map("discount_applied")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([couponId])
  @@index([clientId])
  @@map("coupon_redemptions")
}

model MembershipPlan {
  id             String         @id @default(cuid())
  businessId     String         @map("business_id")
  business       Business       @relation(fields: [businessId], references: [id])
  name           String
  price          Decimal        @db.Decimal(10, 2)
  billingCycle   BillingCycle   @default(monthly) @map("billing_cycle")
  usageLimitType UsageLimitType @map("usage_limit_type")
  usageLimit     Int?           @map("usage_limit")
  serviceIds     Json           @default("[]") @map("service_ids")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")

  memberships ClientMembership[]

  @@index([businessId])
  @@map("membership_plans")
}

model ClientMembership {
  id            String           @id @default(cuid())
  businessId    String           @map("business_id")
  business      Business         @relation(fields: [businessId], references: [id])
  clientId      String           @map("client_id")
  client        Client           @relation(fields: [clientId], references: [id])
  planId        String           @map("plan_id")
  plan          MembershipPlan   @relation(fields: [planId], references: [id])
  status        MembershipStatus @default(pending)
  cycleStart    DateTime         @map("cycle_start")
  cycleEnd      DateTime         @map("cycle_end")
  usageInCycle  Int              @default(0) @map("usage_in_cycle")
  paymentStatus PaymentStatusEnum @default(unpaid) @map("payment_status_enum")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([businessId])
  @@index([clientId])
  @@map("client_memberships")
}

model StaffInvite {
  id              String    @id @default(cuid())
  businessId      String    @map("business_id")
  business        Business  @relation(fields: [businessId], references: [id])
  email           String
  role            Role
  professionalId  String?   @map("professional_id")
  tokenHash       String    @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  invitedByUserId String    @map("invited_by_user_id")
  invitedBy       User      @relation(fields: [invitedByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([businessId])
  @@index([businessId, email])
  @@map("staff_invites")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
