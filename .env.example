# --- Banco e cache ---
DATABASE_URL=mysql://agenda:agenda@localhost:3306/agenda
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) --- troque os secrets em produção (>= 16 chars aleatórios) ---
JWT_ACCESS_SECRET=troque-em-producao
JWT_REFRESH_SECRET=troque-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

NODE_ENV=development
# PORT=3001                                                   # opcional; default 3001
# CORS_ORIGINS=http://localhost:3000,http://localhost:3005    # opcional; default cobre o web em dev

# --- URLs (links de e-mail e callbacks de pagamento) ---
APP_URL=http://localhost:3001       # base da API
APP_WEB_URL=http://localhost:3000   # base do app web (link de redefinição de senha)
WEB_URL=http://localhost:3000       # base do app web (retorno da assinatura de plano)

# --- Notificações por e-mail (enviadas pelo worker) ---
# Sem RESEND_API_KEY os e-mails são apenas simulados no log.
RESEND_API_KEY=
MAIL_FROM=
FEEDBACK_EMAIL=

# --- Pagamento (Mercado Pago, modo conta única de testes) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Cobrança online no agendamento: DESLIGADA no beta (split/payout = checkpoint de
# produção). Reative com =true só depois de plugar split + saque.
ONLINE_PAYMENTS_ENABLED=false

# --- Object storage para uploads (logo, capa, galeria, favicon) ---
# Defina as quatro (endpoint/bucket/keys) para usar R2/S3/Spaces; sem elas a API
# grava em disco local (efêmero, só dev).
# R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  |  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMS (pós-beta, desligado) ---
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PROCESS_ROLE=worker é definido apenas no processo worker (ver docker-compose);
# nesse modo ele consome a fila e roda os @Cron. A API não precisa definir.
