# --- Banco e cache ---
DATABASE_URL=mysql://agenda:agenda@localhost:3306/agenda
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) --- troque os secrets em produção (>= 16 chars aleatórios) ---
JWT_ACCESS_SECRET=troque-em-producao
JWT_REFRESH_SECRET=troque-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

NODE_ENV=development
# PORT=3001                                                   # opcional; default 3001
# CORS_ORIGINS=http://localhost:3000,http://localhost:3005    # opcional; default cobre o web em dev

# --- URLs (links de e-mail e callbacks de pagamento) ---
APP_URL=http://localhost:3001       # base da API
APP_WEB_URL=http://localhost:3000   # base do app web (link de redefinição de senha)
WEB_URL=http://localhost:3000       # base do app web (retorno da assinatura de plano)

# --- Notificações por e-mail (enviadas pelo worker) ---
# Sem RESEND_API_KEY os e-mails são apenas simulados no log.
RESEND_API_KEY=
MAIL_FROM=
FEEDBACK_EMAIL=

# --- Pagamento (Mercado Pago) ---
# Token da conta da PLATAFORMA: recebe a assinatura de plano e a comissão do split.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# --- Split marketplace (Mercado Pago Connect / OAuth) ---
# Credenciais da APLICAÇÃO de marketplace registrada no painel do MP. O lojista
# conecta a conta MP dele por OAuth e o pagamento do agendamento cai direto na
# conta dele (o dinheiro nunca passa pela plataforma).
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# URL fixa de callback do OAuth (deve bater com a cadastrada no app do MP).
# Default (se vazio): {APP_URL}/payment-account/oauth/callback
MERCADOPAGO_OAUTH_REDIRECT_URI=
# Comissão da plataforma sobre o agendamento (application_fee), em %. 0 = sem comissão.
MERCADOPAGO_APPLICATION_FEE_PERCENT=0
# Chave para cifrar os tokens OAuth do lojista guardados no banco (AES-256-GCM).
# 32 bytes em hex (64 chars) — ex.: openssl rand -hex 32. Obrigatória para conectar.
TOKEN_ENCRYPTION_KEY=
# Cobrança online no agendamento. Ligue (=true) depois de registrar o app de
# marketplace e configurar o OAuth acima.
ONLINE_PAYMENTS_ENABLED=false

# --- Analytics (Microsoft Clarity) — heatmaps, scroll, replay ---
# ID público do projeto Clarity. Inlined no build do web (NEXT_PUBLIC_*).
# Vazio = tracking desligado. Também dá para passar via --build-arg no Dockerfile.
NEXT_PUBLIC_CLARITY_ID=yiwdunm70s

# --- Object storage para uploads (logo, capa, galeria, favicon) ---
# Defina as quatro (endpoint/bucket/keys) para usar R2/S3/Spaces; sem elas a API
# grava em disco local (efêmero, só dev).
# R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  |  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMS (pós-beta, desligado) ---
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PROCESS_ROLE=worker é definido apenas no processo worker (ver docker-compose);
# nesse modo ele consome a fila e roda os @Cron. A API não precisa definir.
